{
  "name": "global-landmark",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/dev-db.mjs",
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && (node scripts/seed.mjs || true) && next build",
    "postbuild": "node scripts/standalone-assets.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "check:sw": "node scripts/check-sw.mjs",
    "check:taxonomy": "node scripts/check-taxonomy.mjs",
    "check:features": "node scripts/check-features.mjs",
    "check:storage": "node scripts/check-storage.mjs",
    "check:news": "node scripts/check-news.mjs",
    "check": "npm run check:sw && npm run check:taxonomy && npm run check:features && npm run check:storage && npm run check:news && npm run check:legal && tsc --noEmit && eslint .",
    "sweep:uploads": "node scripts/sweep-orphan-uploads.mjs",
    "check:legal": "node scripts/check-legal.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.38.0",
    "mysql2": "^3.24.3",
    "next": "16.2.10",
    "nodemailer": "^9.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
